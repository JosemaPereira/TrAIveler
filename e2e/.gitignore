# =============================================================================
# E2E Test Artifacts - Playwright & Node.js
# =============================================================================

# Node.js dependencies
# Excluded: ~350MB of packages, regenerated from package-lock.json
node_modules/

# Package lock file
# Excluded: Auto-generated from package.json, creates merge conflicts
# Alternative: Could track this to ensure deterministic dependency versions
package-lock.json

# =============================================================================
# Playwright Test Artifacts
# =============================================================================

# Test results directory
# Contains: Per-test folders with failure screenshots, traces, videos
# Excluded: Generated on every run, can be large (10-100MB per failed test)
test-results/

# HTML test report
# Contains: Static HTML/CSS/JS report showing test results
# Excluded: Generated by `playwright test`, view with `npm run report`
playwright-report/

# Playwright browser cache
# Contains: Cached browser profiles and extensions
# Excluded: Auto-managed by Playwright, can be regenerated
playwright/.cache/

# Test traces (debugging artifacts)
# Contains: Step-by-step execution recordings for failed tests
# Excluded: Large files (1-10MB each), attached to test-results/
*.trace.zip

# Test videos
# Contains: WebM video recordings of test execution
# Excluded: Large files (5-50MB each), enabled via playwright.config.ts
*.webm

# =============================================================================
# Screenshots
# =============================================================================

# Playwright screenshots
# Note: Intentionally NOT excluded — commit these for visual regression testing
# If you want to exclude: uncomment the line below
# screenshots/

# =============================================================================
# Environment & Secrets
# =============================================================================

# Environment variables
# Excluded: Contains sensitive data (API keys, credentials)
.env
.env.local
.env.*.local

# =============================================================================
# Operating System
# =============================================================================

# macOS metadata
.DS_Store

# Windows thumbnails
Thumbs.db

# =============================================================================
# IDE / Editor
# =============================================================================

# VS Code workspace settings
# Note: Only user-specific settings excluded, not .vscode/settings.json
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains IDEs (WebStorm, IntelliJ)
.idea/

# Vim swap files
*.swp
*.swo
*~

# =============================================================================
# Logs
# =============================================================================

# Runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Test Coverage (if added in future)
# =============================================================================

# Istanbul/NYC coverage reports
coverage/
.nyc_output/
