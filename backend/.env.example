# Backend Configuration Template
# Copy to .env and populate with actual values
# ⚠️  NEVER commit .env to version control

# === Server Configuration ===
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
ALLOWED_CORS_ORIGINS=http://localhost:5173

# === Database Configuration ===
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=disable
DATABASE_URL=postgresql://traveler_user:traveler_pass@localhost:5432/traveler_db?sslmode=disable
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5
DB_MAX_IDLE_TIME=15m
DB_MAX_LIFETIME=1h

# === AI Provider Configuration ===
# Anthropic API key (required)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-3-5-sonnet-20241022
AI_TIMEOUT=60s
AI_MAX_RETRIES=3
AI_STREAMING_CHUNK_SIZE=4096

# === Authentication Configuration ===
# JWT signing key (generate with: openssl rand -base64 32)
# ⚠️  REQUIRED in production, optional in development
JWT_SIGNING_KEY=your_jwt_signing_key_here
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=168h

# Cookie settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
BCRYPT_COST=12

# === Logging Configuration ===
# Levels: debug, info, warn, error
LOG_LEVEL=info
LOG_FORMAT=json

# === Environment ===
# Options: development, staging, production
GO_ENV=development
