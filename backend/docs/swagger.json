                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/errors.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Deletes an example resource by its ID, responding 204 with no body on success\nper docs/api-design-standards.md §8",
                "tags": [
                    "examples"
