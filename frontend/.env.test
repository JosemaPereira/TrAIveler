# Environment variables for `vitest` (mode "test").
# Loaded automatically by Vite/Vitest — committed on purpose (mirrors .env.example),
# unlike .env.test.local which stays git-ignored for personal overrides.
# Tests mock `fetch` directly, so this value is never dereferenced over the network;
# it only needs to satisfy api-client.ts's required-env-var check.
VITE_API_BASE_URL=http://localhost:8080/api/v1
