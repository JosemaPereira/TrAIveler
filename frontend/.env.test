# Environment variables for `vitest` (mode "test").
# Loaded automatically by Vite/Vitest — committed on purpose (mirrors .env.example),
# unlike .env.test.local which stays git-ignored for personal overrides.
# Never dereferenced over the network: requests are either answered by MSW (which builds its
# handler URLs from this same value, so the two cannot drift) or by a stubbed global `fetch`.
# It also has to be set at all, to satisfy api-client.ts's required-env-var check.
VITE_API_BASE_URL=http://localhost:8080/api/v1
